[Unit]
Description=CodeShot API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kdn
WorkingDirectory=/home/kdn/projects/code-shot-api
Environment="PATH=/home/kdn/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/kdn/.hermes/.env
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
