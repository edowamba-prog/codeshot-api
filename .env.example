# ============================================================
# CodeShot API — Environment Variables
# Copy to .env for local dev, or set in Railway dashboard.
# ============================================================

# ── Server ──
# DOMAIN: your deployed URL (used for Stripe redirects, dashboard links)
DOMAIN=https://codeshot-api-production.up.railway.app
# PORT: Railway sets this automatically, local dev defaults to 8000
PORT=8000

# ── DeepSeek AI (for /v1/annotate) ──
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ── Auth ──
# JWT_SECRET: auto-generated on first run if not set
JWT_SECRET=

# ── Stripe Billing ──
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Prices (defaults point to existing Stripe products)
STRIPE_PRICE_PRO=price_1TZfqJHMkYtoDU24yPATdwHt      # $10/month
STRIPE_PRICE_TEAM=price_1TZft1HMkYtoDU24ogtfAbqL     # $30/month
STRIPE_PRICE_BUSINESS=price_1TZfw3HMkYtoDU24U9ngLp6y  # $100/month
STRIPE_PRICE_LIFETIME=price_1TZrmvHMkYtoDU24K3hf9NE9  # $49 one-time
