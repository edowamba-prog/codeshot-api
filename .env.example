# ============================================================
# CodeShot API — Environment Variables
# Copy to .env for local dev, or set in Railway dashboard.
# ============================================================

# ── Server ──
# DOMAIN: your deployed URL (used for Stripe redirects, dashboard links)
DOMAIN=https://codeshot-api-production.up.railway.app
# PORT: Railway sets this automatically, local dev defaults to 8000
PORT=8000

# ── DeepSeek AI (for /v1/annotate) ──
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ── Auth ──
# JWT_SECRET: auto-generated on first run if not set. Set a fixed value for production.
JWT_SECRET=your-jwt-secret-here

# ── Stripe Billing ──
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
# Get this from Stripe Dashboard > Developers > Webhooks > your endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs — create Products & Prices in Stripe Dashboard first:
# https://dashboard.stripe.com/products
STRIPE_PRICE_PRO=price_xxx          # $9/month Pro plan
STRIPE_PRICE_TEAM=price_xxx         # $29/month Team plan
STRIPE_PRICE_BUSINESS=price_xxx     # $99/month Business plan
STRIPE_PRICE_LIFETIME=price_xxx     # One-time $49 lifetime Pro
